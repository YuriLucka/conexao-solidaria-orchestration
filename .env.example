# Copie para .env e ajuste. Valores de demonstração (ambiente local); não use em produção.
POSTGRES_USER=conexao
POSTGRES_PASSWORD=conexao-dev
RABBIT_USER=conexao
RABBIT_PASS=conexao-dev
# Mínimo 32 caracteres.
JWT_SECRET=chave-local-de-desenvolvimento-com-32-caracteres-ou-mais
# Senha da conta de gestão criada na primeira subida (helena@esperancasolidaria.demo).
GESTOR_SENHA=Gestao@2026
# Kubernetes: observabilidade. O Zabbix troca a senha padrão do Admin por esta na primeira subida
# (a política do Zabbix não aceita senha com o nome do usuário, "Zabbix").
GRAFANA_USER=admin
GRAFANA_PASSWORD=Grafana@2026
ZABBIX_PASSWORD=Monitora@2026
ZABBIX_DB_PASSWORD=zabbix-dev
